# Environment
ENV=development

# Database
# Local development without Docker (Windows/Linux/macOS): SQLite
DATABASE_URL=sqlite:///./cuidar.db
# Docker Compose (PostgreSQL):
# POSTGRES_DB=cuidar
# POSTGRES_USER=cuidar
# POSTGRES_PASSWORD=change_me
# DATABASE_URL=postgresql+psycopg://cuidar:change_me@db:5432/cuidar

# Security (replace in production)
JWT_SECRET_KEY=change_me_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
FERNET_KEY=
TRACKING_CODE_PEPPER=change_me_pepper

# CORS / Frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
VITE_API_BASE_URL=http://localhost:8000

# Captcha (mock in development)
CAPTCHA_PROVIDER=mock
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
